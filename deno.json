{
  "tasks": {
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "doc": "deno run --allow-read --allow-write scripts/build-docs.js"
  },
  "nodeModulesDir": true,
  "imports": {
    "@tangent.to/ds": "npm:@tangent.to/ds@0.4.5",
    "plotly.js": "npm:plotly.js@2.26.0"
  },
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "lint": {
    "include": ["src/"],
    "exclude": ["node_modules/", "examples/", "tests/", "src/browser/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-unused-vars"]
    }
  },
  "fmt": {
    "include": ["src/", "examples/", "tests/"],
    "exclude": ["node_modules/"],
    "options": {
      "useTabs": false,
      "lineWidth": 100,
      "indentWidth": 2,
      "semiColons": true,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  },
  "test": {
    "include": ["tests/", "src/**/__tests__/"]
  }
}
